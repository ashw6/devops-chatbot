# Leave DATABASE_URL empty to use a local SQLite file (easy development).
# PostgreSQL example: postgresql+psycopg2://faq:faqpass@localhost:5432/faqdb
DATABASE_URL=
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173
VECTOR_STORE_PATH=data/faiss_index

# --- AI settings ---
# EMBEDDING_PROVIDER=local works offline (hashing embeddings). Use "openai" for better retrieval.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# Local embeddings score lower than OpenAI ones: ~0.30 for local, ~0.45 for openai.
CONFIDENCE_THRESHOLD=0.30

# --- Setup / seeding ---
SEED_DEMO=true
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=Admin@123
AUTO_CLOSE_DAYS=7
